      "source": [
        "pred_line = (w * xs + b) * y.std() + y.mean()\n",
        "\n",
        "plt.scatter(x, y)\n",
        "plt.plot(x, pred_line, color=\"red\")\n",
        "plt.xlabel(\"BMI\")\n",
        "plt.ylabel(\"patient progression\")\n",
