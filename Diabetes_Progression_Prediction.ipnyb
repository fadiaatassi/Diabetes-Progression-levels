      ]
    },
    {
      "cell_type": "code",
      "source": [
        "x = df[\"bmi\"].values\n",
        "y = df[\"progression\"].values\n",
        "\n",
        "xs = (x - x.mean()) / x.std()\n",
        "ys = (y - y.mean()) / y.std()"
      ],
      "metadata": {
        "id": "XqYFU0yqfot1"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def cost(w, b):\n",
        "    pred = w * xs + b\n",
        "    error = pred - ys\n",
        "    return (error ** 2).mean() / 2"
      ],
      "metadata": {
        "id": "-5IbTmB8k_sL"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(cost(0, 0))\n",
        "print(cost(1, 0))\n",
        "print(cost(0.59, 0))"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "2QHC7hvgmAPU",
        "outputId": "b05e898a-32f0-4164-cd6d-c1f2bac71360"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "0.5\n",
            "0.4135498655253114\n",
            "0.3280444206599338\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "w = 0\n",
        "b = 0\n",
        "alpha = 0.1\n",
        "history = []\n",
        "\n",
        "for i in range(1000):\n",
        "    pred = w * xs + b\n",
        "    error = pred - ys\n",
        "\n",
        "    dw = (error * xs).mean()\n",
        "    db = error.mean()\n",
        "    w = w - alpha * dw\n",
        "    b = b - alpha * db\n",
        "    history.append(cost(w, b))\n",
        "\n",
        "print(w, b)\n",
        "print(cost(w, b))"
      ],
      "metadata": {
